{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumebox-translation",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": {
    "AI_BACKEND": "workers-ai",
    "AI_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
  },
  "observability": { "enabled": false }
}
